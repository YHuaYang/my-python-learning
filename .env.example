# 复制此文件为 .env 并填入真实值。
# .env 不进版本库，.env.example 进版本库作为模板。

# Django 密钥，用以下命令生成：
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=填入生成的密钥

# 开发环境用 True；生产环境必须 False，否则报错页会泄露源码
DEBUG=True

# 逗号分隔，生产环境填实际域名
ALLOWED_HOSTS=localhost,127.0.0.1

# 只在生产环境且有 HTTPS 证书时设为 True。
# 开启后会：HTTP 永久重定向到 HTTPS、cookie 只走 HTTPS、启用 HSTS。
# 本地没有证书时开启会导致所有请求 301 到 https:// 而连不上。
USE_HTTPS=False
