# AI 保存用（文档、笔记、杂项，不入库）
ai保存用/

# Node / 前端构建
node_modules/
# 构建产物：改源码后跑 npm run build 重新生成，不进版本库
blog/static/css/tailwind.css
blog/static/js/bundle.js
blog/static/js/chunk-*.js
# 后台 Markdown 编辑器的产物（Toast UI，539KB）。
# 两个入口分开输出，除下列回退规则外，用通配符避免
# 以后新增入口时又忘加一条：凡是构建出的 js 与 asset-*.css 都不入库
blog/static/js/admin-editor.js
blog/static/js/asset-*.css

# 部署时临时归拢的构建产物（deploy/collect-assets.sh 的产出），
# 只用于 scp 上传，不进版本库
/upload/